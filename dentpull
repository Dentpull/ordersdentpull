<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1" />
<title>Заказы PDR</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');

  :root{
    --bg:#17181A; --surface:#212327; --surface2:#26282C; --border:#2E3136;
    --text:#ECE9E2; --muted:#8B8E93; --muted2:#6B6E73;
    --amber:#E3A335; --green:#6FA987; --green-bg:#1D2621; --green-bd:#3E5C4C;
    --red:#C97361; --red-bg:#261D1B; --red-bd:#5C3E38;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html,body{margin:0; padding:0; background:var(--bg); color:var(--text);
    font-family:'Inter',system-ui,sans-serif; min-height:100vh;}
  .display{font-family:'Oswald',system-ui,sans-serif; letter-spacing:.01em;}
  .tabular{font-variant-numeric:tabular-nums;}
  .wrap{max-width:460px; margin:0 auto; padding-bottom:110px;}

  header{padding:28px 20px 16px;}
  h1{font-size:24px; font-weight:600; margin:0;}
  .sub{color:var(--muted); font-size:14px; margin-top:3px;}

  .stats{display:grid; grid-template-columns:repeat(3,1fr); gap:10px; padding:0 20px;}
  .stat{background:var(--surface); border:1px solid var(--border); border-radius:12px; padding:12px;}
  .stat-label{color:var(--muted); font-size:11px; text-transform:uppercase; letter-spacing:.03em;}
  .stat-val{font-size:18px; font-weight:600; margin-top:4px;}
  .stat-val.amber{color:var(--amber);}
  .debt{color:var(--red); font-size:11px; font-weight:400; margin-left:6px; font-family:'Inter';}

  .search-wrap{padding:20px 20px 0;}
  #search{width:100%; background:var(--surface); border:1px solid var(--border); border-radius:12px;
    padding:10px 14px; color:var(--text); font-size:14px; outline:none;}
  #search::placeholder{color:#6B6E73;}
  #search:focus{border-color:var(--amber);}

  .list{padding:20px 20px 0;}
  .month-label{color:var(--muted2); font-size:12px; text-transform:uppercase; letter-spacing:.03em;
    margin:0 0 8px 2px;}
  .group{margin-bottom:20px;}
  .card{background:var(--surface); border:1px solid var(--border); border-radius:12px;
    padding:12px 16px; margin-bottom:8px; cursor:pointer; display:flex; justify-content:space-between;
    gap:12px; align-items:flex-start;}
  .card:active{background:var(--surface2);}
  .card-name{font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .card-car{color:var(--muted); font-size:14px; margin-top:2px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
  .card-date{color:var(--muted2); font-size:12px; margin-top:5px;}
  .card-right{text-align:right; flex-shrink:0;}
  .card-amount{font-weight:600;}
  .badge{margin-top:6px; font-size:11px; padding:2px 8px; border-radius:999px; border:1px solid; display:inline-block;}
  .badge.paid{border-color:var(--green-bd); color:var(--green); background:var(--green-bg);}
  .badge.unpaid{border-color:var(--red-bd); color:var(--red); background:var(--red-bg);}

  .empty{color:var(--muted); font-size:14px; text-align:center; padding:56px 20px; line-height:1.6;}

  .fab{position:fixed; bottom:24px; right:24px; width:56px; height:56px; border-radius:50%;
    background:var(--amber); color:var(--bg); border:none; font-size:26px; font-weight:600;
    box-shadow:0 8px 24px rgba(0,0,0,.4); cursor:pointer;}
  .fab:active{transform:scale(.95);}

  .overlay{position:fixed; inset:0; background:rgba(0,0,0,.6); display:none; z-index:20;
    align-items:flex-end; justify-content:center;}
  .overlay.open{display:flex;}
  .overlay.center{align-items:center; padding:0 24px;}
  .sheet{width:100%; max-width:460px; background:#1C1E21; border-top:1px solid var(--border);
    border-radius:20px 20px 0 0; padding:16px 20px 24px; max-height:88vh; overflow-y:auto;
    animation:up .25s cubic-bezier(.22,1,.36,1);}
  @keyframes up{from{transform:translateY(100%)} to{transform:translateY(0)}}
  .handle{width:36px; height:4px; background:#3A3D42; border-radius:99px; margin:0 auto 16px;}
